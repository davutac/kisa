{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "extends": "./tsconfig.web.json",
  "include": [
    "src/main/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "../../packages/database/src/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/vitest",
          "effect/rpc",
          "effect/workers"
        ]
      }
    ],
    "types": ["node", "vite/client", "vitest/globals"]
  }
}
