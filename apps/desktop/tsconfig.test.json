{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "extends": "./tsconfig.web.json",
  "include": [
    "src/main/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "../../packages/database/src/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "plugins": [{ "name": "@effect/language-service" }],
    "types": ["node", "vite/client", "vitest/globals"]
  }
}
