{
  "name": "kisa",
  "version": "0.2.0",
  "private": true,
  "description": "Kisa a minimal email client",
  "homepage": "https://kisa.email",
  "author": "Davut Caliskan",
  "repository": {
    "type": "git",
    "url": "https://github.com/davutac/kisa.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "bun run typecheck && electron-vite build && node scripts/check-preload-bundles.mjs",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:unpack": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "dev": "electron-vite dev",
    "dev:demo": "electron-vite dev -- --demo",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "bun run --parallel --no-exit-on-error typecheck:node typecheck:web typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@electron-toolkit/utils": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@number-flow/react": "catalog:",
    "@opencode/client": "catalog:",
    "@repo/database": "workspace:*",
    "@repo/mail": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@ui-sdk/core": "catalog:",
    "@ui-sdk/react": "catalog:",
    "better-sqlite3": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "electron-updater": "catalog:",
    "imapflow": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "nodemailer": "catalog:",
    "pdfjs-dist": "catalog:",
    "sharp": "catalog:",
    "tailwind-merge": "catalog:",
    "tldts": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@electron-toolkit/tsconfig": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "desktopName": "kisa.desktop"
}
