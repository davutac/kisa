    "@fontsource-variable/geist": "catalog:",
    "@googleapis/gmail": "catalog:",
    "@opencode-ai/sdk": "catalog:",
    "@repo/database": "workspace:*",
    "@repo/gmail": "workspace:*",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "better-sqlite3": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
