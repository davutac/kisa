{
  "name": "kisa",
  "version": "0.1.39",
  "private": true,
  "description": "Kisa a minimal email client",
  "homepage": "https://kisa.email",
  "author": "Davut Caliskan",
  "repository": {
    "type": "git",
    "url": "https://github.com/davutac/kisa.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "pnpm run typecheck && electron-vite build && node scripts/check-preload-bundles.mjs",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:unpack": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "dev": "pnpm run ensure:electron && electron-vite dev",
    "ensure:electron": "node node_modules/electron/install.js",
    "postinstall": "pnpm run ensure:electron && electron-builder install-app-deps",
    "start": "pnpm run ensure:electron && electron-vite preview",
    "test": "vitest run tests",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@base-ui/react": "catalog:",
    "@dnd-kit/dom": "catalog:",
    "@dnd-kit/react": "catalog:",
