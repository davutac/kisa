{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/constants.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@/shared/*": ["./src/shared/*"],
      "@/constants": ["./src/constants.ts"]
    },
    "resolveJsonModule": true,
    "types": ["electron-vite/node", "node"],
    "strictNullChecks": true
  }
}
