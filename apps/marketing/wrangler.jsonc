{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kisa-mail",
  "compatibility_date": "2026-08-10",
  "routes": [
    {
      "pattern": "kisa.email",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": false,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
