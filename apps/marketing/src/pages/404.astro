---
import { ArrowLeftIcon } from "lucide-react";

import { buttonVariants } from "@/components/ui/button";
import BaseLayout from "@/layouts/base-layout.astro";
---

<BaseLayout description="The page you were looking for could not be found." title="Page not found | Kisa">
  <main class="grid min-h-screen place-items-center px-5 text-center">
    <div>
      <p class="text-sm font-medium text-muted-foreground">404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight">Nothing in this thread.</h1>
      <p class="mt-4 text-sm text-muted-foreground">The page you were looking for does not exist.</p>
      <a class={buttonVariants({ className: "mt-7", variant: "outline" })} href="/">
        <ArrowLeftIcon />
        Back to Kisa
      </a>
    </div>
  </main>
</BaseLayout>
