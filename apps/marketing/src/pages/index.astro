---
import {
  ArchiveRestoreIcon,
  ArrowLeftIcon,
  ArrowRightIcon,
  BoldIcon,
  CheckIcon,
  ChevronRightIcon,
  CodeIcon,
  DatabaseIcon,
  DownloadIcon,
  EyeIcon,
  FileCodeIcon,
  FilesIcon,
  HouseIcon,
  ItalicIcon,
  KeyboardIcon,
  LinkIcon,
  ListFilterIcon,
  ListIcon,
  ListOrderedIcon,
  MessageSquarePlusIcon,
  MessagesSquareIcon,
  MinusIcon,
  PanelLeftCloseIcon,
  PanelLeftOpenIcon,
  PaperclipIcon,
  PlusIcon,
  QuoteIcon,
  Redo2Icon,
  SearchIcon,
  SendIcon,
  SettingsIcon,
  ShieldAlertIcon,
  ShieldCheckIcon,
  SparklesIcon,
  SquarePenIcon,
  StarIcon,
  StrikethroughIcon,
  TagIcon,
  TagsIcon,
  Trash2Icon,
  UnderlineIcon,
  Undo2Icon,
  XIcon,
} from "lucide-react";

import GithubMark from "@/components/github-mark.astro";
import ThemeToggle from "@/components/theme-toggle";
import { buttonVariants } from "@/components/ui/button";
import XMark from "@/components/x-mark.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { cn } from "@/lib/utils";

const repositoryUrl = "https://github.com/davutac/kisa";

const features = [
  {
    description:
      "Create replies from thread context or clean up a draft with Codex, Claude Code, or OpenCode.",
    icon: SparklesIcon,
    title: "AI writing, your choice",
  },
  {
    description:
      "Save the sender, recipients, subject, and body together. Type / in a new email to insert it with variables resolved.",
    icon: FilesIcon,
    title: "Reusable templates",
  },
  {
    description:
      "Clear new mail without losing track. Stash a message and Kisa brings it back when you choose.",
    icon: ArchiveRestoreIcon,
    title: "Stash until later",
  },
  {
    description:
      "Your cache and full-text search index live in an encrypted database on your device.",
    icon: DatabaseIcon,
    title: "Local by design",
  },
  {
    description:
      "Move through mail, search, switch accounts, and take action without reaching for the mouse.",
    icon: KeyboardIcon,
    title: "Made for momentum",
  },
  {
    description:
      "Credentials stay outside the renderer. Message HTML is isolated and remote images wait for you.",
    icon: ShieldCheckIcon,
    title: "Private by default",
  },
];

const inlineComposerTools = [
  { icon: BoldIcon, label: "Bold" },
  { icon: ItalicIcon, label: "Italic" },
  { icon: UnderlineIcon, label: "Underline" },
  { icon: StrikethroughIcon, label: "Strikethrough" },
  { icon: CodeIcon, label: "Inline code" },
  { icon: LinkIcon, label: "Link" },
];

const blockComposerTools = [
  { icon: ListIcon, label: "Bulleted list" },
  { icon: ListOrderedIcon, label: "Numbered list" },
  { icon: QuoteIcon, label: "Quote" },
  { icon: FileCodeIcon, label: "Code block" },
  { icon: MinusIcon, label: "Horizontal rule" },
];

const historyComposerTools = [
  { icon: Undo2Icon, label: "Undo" },
  { icon: Redo2Icon, label: "Redo" },
];

// The hero preview mirrors the desktop app's main window: the sidebar beside
// one account's Inbox. Its numbers agree with each other, as they would in the
// app: the account's unread count is the unread rows listed, and a label's
// count is the unread rows carrying it.
const previewAccount = "davut@example.com";

const sidebarAccounts = [
  { email: previewAccount, expanded: true, provider: "gmail", unread: 2 },
  { email: "hello@example.org", provider: "apple", unread: 1 },
  { email: "work@example.net", provider: "outlook", unread: 0 },
];

const sidebarMailboxes = [
  { icon: StarIcon, name: "Starred" },
  { icon: SendIcon, name: "Sent" },
  { icon: ShieldAlertIcon, name: "Spam" },
  { icon: Trash2Icon, name: "Trash" },
];

const mailboxLabels = [
  { background: "#3c78d8", name: "Design", text: "#ffffff", unread: 1 },
  { background: "#8e63ce", name: "Personal", text: "#ffffff", unread: 0 },
  { background: "#a479e2", name: "Photos", text: "#ffffff", unread: 0 },
  { background: "#eaa041", name: "Updates", text: "#3c1f00", unread: 0 },
  { background: "#0b8043", name: "Work", text: "#ffffff", unread: 1 },
];

const labelColors = new Map(mailboxLabels.map((label) => [label.name, label]));

interface PreviewThread {
  attachments?: { filename: string; kind: "download" | "preview"; type: string }[];
  email: string;
  labels?: string[];
  messageCount?: number;
  preview: string;
  sender: string;
  starred?: boolean;
  subject: string;
  time: string;
  unread: boolean;
}

const threadDays: { day: string; threads: PreviewThread[] }[] = [
  {
    day: "Today",
    threads: [
      {
        attachments: [
          { filename: "design-notes.pdf", kind: "preview", type: "PDF" },
          { filename: "handoff.zip", kind: "download", type: "ZIP" },
        ],
        email: "maya@example.com",
        labels: ["Design", "Work"],
        messageCount: 3,
        preview: "The calm direction feels right. One thought…",
        sender: "Maya Chen",
        subject: "Design review",
        time: "10:42",
        unread: true,
      },
      {
        email: "alex@example.com",
        preview: "Saturday morning works perfectly for us.",
        sender: "Alex Morgan",
        subject: "Weekend plans",
        time: "09:18",
        unread: true,
      },
    ],
  },
  {
    day: "Yesterday",
    threads: [
      {
        email: "notifications@linear.app",
        labels: ["Updates"],
        preview: "12 issues completed across 3 projects.",
        sender: "Linear",
        subject: "Your weekly digest",
        time: "Yesterday",
        unread: false,
      },
    ],
  },
  {
    day: "Sunday",
    threads: [
      {
        attachments: [
          { filename: "berlin-01.jpg", kind: "preview", type: "JPG" },
          { filename: "berlin-02.jpg", kind: "preview", type: "JPG" },
          { filename: "berlin-03.jpg", kind: "preview", type: "JPG" },
          { filename: "weekend-map.pdf", kind: "preview", type: "PDF" },
        ],
        email: "nora@example.com",
        labels: ["Personal", "Photos"],
        preview: "Finally sorted these. Thought you'd like them.",
        sender: "Nora Patel",
        starred: true,
        subject: "Photos from Berlin",
        time: "Sun",
        unread: false,
      },
    ],
  },
  {
    day: "Friday",
    threads: [
      {
        email: "hello@raycast.com",
        preview: "A calmer command bar and a few small refinements.",
        sender: "Raycast",
        subject: "What's new this week",
        time: "Fri",
        unread: false,
      },
      {
        attachments: [{ filename: "invoice-october.pdf", kind: "preview", type: "PDF" }],
        email: "sam@example.com",
        messageCount: 2,
        preview: "Attached is the invoice for last month. Thanks again!",
        sender: "Sam Rivera",
        subject: "Invoice for October",
        time: "Fri",
        unread: false,
      },
    ],
  },
];

// Shared by the preview's static stand-ins for the app's ghost icon buttons.
const previewIconButton = "grid shrink-0 place-items-center rounded-md text-muted-foreground";
const sidebarRow =
  "flex h-8 w-full items-center gap-2.5 rounded-md px-2 text-[13px] text-sidebar-foreground/75";
const sidebarRowCurrent = "bg-sidebar-accent font-medium text-sidebar-accent-foreground";
const sidebarCount =
  "inline-flex h-4 min-w-4 shrink-0 items-center justify-center rounded-full bg-sidebar-foreground/10 px-1 text-[10px] font-medium tabular-nums text-sidebar-foreground/80";
---

<BaseLayout
  description="Kisa is a local-first desktop email client with AI writing through your existing Codex, Claude Code, or OpenCode setup."
  title="Kisa"
>
  <div class="page-shell relative overflow-x-clip">
    <header class="sticky inset-x-0 top-0 z-50" data-sticky-header>
      <div aria-hidden="true" class="header-backdrop" data-header-backdrop></div>
      <div class="relative mx-auto flex h-18 max-w-6xl items-center justify-between px-5 sm:px-8">
        <a class="flex items-center gap-2.5" href="#top" aria-label="Kisa home">
          <img
            alt=""
            class="size-8 rounded-lg shadow-sm"
            height="32"
            src="/icon.png"
            width="32"
          />
          <span class="text-sm font-semibold tracking-tight">Kisa</span>
        </a>

        <nav class="flex items-center gap-1" aria-label="Primary navigation">
          <a class="hidden rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground sm:block" href="#features">
            Features
          </a>
          <a class="hidden rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground sm:block" href="#ai">
            AI writing
          </a>
          <a class="hidden rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground sm:block" href="/privacy/">
            Privacy
          </a>
          <a
            class="inline-flex size-10 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            href={repositoryUrl}
            rel="noreferrer"
            target="_blank"
            aria-label="View Kisa on GitHub"
          >
            <GithubMark />
          </a>
          <ThemeToggle client:load />
        </nav>
      </div>
    </header>

    <main class="relative z-10" id="top">
      <section class="mx-auto flex max-w-4xl flex-col items-center px-5 pb-16 pt-22 text-center sm:px-8 sm:pb-24 sm:pt-30">
        <h1 class="reveal max-w-3xl text-balance text-5xl font-semibold tracking-[-0.055em] sm:text-7xl sm:leading-[0.98]">
          Email, without the noise.
        </h1>

        <p class="reveal reveal-delay mt-6 max-w-2xl text-pretty text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
          Read, search, write, and organize mail in one calm desktop app. When you want help writing, Kisa works with the AI tools already installed and signed in on your computer.
        </p>

        <div class="reveal reveal-delay mt-8 flex flex-col items-center gap-3 sm:flex-row">
          <a
            class={cn(buttonVariants({ size: "lg" }), "group min-w-42")}
            href={repositoryUrl}
            rel="noreferrer"
            target="_blank"
          >
            <GithubMark tone="inverse" />
            Follow on GitHub
            <ArrowRightIcon className="transition-transform group-hover:translate-x-0.5" />
          </a>
          <a class={cn(buttonVariants({ size: "lg", variant: "outline" }), "min-w-42")} href="#features">
            See why Kisa
          </a>
        </div>

        <p class="reveal reveal-delay mt-5 flex items-center gap-2 text-xs text-muted-foreground">
          <CheckIcon className="size-3.5" />
          Works with Gmail, iCloud, and Outlook · Open source
        </p>
      </section>

      <section class="mx-auto max-w-6xl px-3 pb-24 sm:px-8 sm:pb-32" aria-label="Kisa desktop app preview">
        <div class="app-shadow overflow-hidden rounded-2xl border bg-background ring-1 ring-foreground/5">
          <div class="app-preview flex h-140 select-none sm:h-160">
            <div class="hidden w-60 shrink-0 flex-col border-r border-sidebar-border bg-sidebar text-sidebar-foreground md:flex">
              <div class="relative flex h-10.5 shrink-0 items-center gap-1 pe-2 ps-20">
                <div class="absolute start-4.5 flex gap-2" aria-hidden="true">
                  <span class="size-3 rounded-full bg-foreground/15"></span>
                  <span class="size-3 rounded-full bg-foreground/15"></span>
                  <span class="size-3 rounded-full bg-foreground/15"></span>
                </div>
                <span class:list={[previewIconButton, "size-7"]} title="Hide sidebar">
                  <PanelLeftCloseIcon className="size-4 stroke-[1.8]" />
                </span>
                <span class="shrink-0 px-1 text-[13px] font-semibold whitespace-nowrap">Kisa</span>
                <span class="flex items-center">
                  <span class:list={[previewIconButton, "size-7"]} title="Go back">
                    <ArrowLeftIcon className="size-4 stroke-[1.8]" />
                  </span>
                  <span class:list={[previewIconButton, "size-7 opacity-50"]} title="Go forward">
                    <ArrowRightIcon className="size-4 stroke-[1.8]" />
                  </span>
                </span>
              </div>

              <div class="flex h-8 shrink-0 items-center gap-1 px-2 mt-1 mb-2">
                <span class="flex h-8 min-w-0 flex-1 items-center gap-2.5 rounded-md px-2 text-[13px] text-muted-foreground" title="Search mail (⌘ K)">
                  <SearchIcon className="size-4 shrink-0 stroke-[1.8]" />
                  <span class="min-w-0 flex-1 truncate">Search all mail</span>
                </span>
                <span class:list={[previewIconButton, "size-8"]} title="Toggle unread filter (U)">
                  <ListFilterIcon className="size-4 stroke-[1.8]" />
                </span>
                <span class:list={[previewIconButton, "size-8"]} title="New email (⌘ N)">
                  <SquarePenIcon className="size-4 stroke-[1.8]" />
                </span>
              </div>

              <div class="flex min-h-0 flex-1 flex-col overflow-hidden px-2 pb-2">
                <ul class="flex flex-col gap-0.5">
                  <li>
                    <span class={sidebarRow}>
                      <HouseIcon className="size-4 shrink-0" />
                      <span class="min-w-0 flex-1 truncate">All accounts</span>
                    </span>
                  </li>
                  {sidebarAccounts.map((account) => (
                    <li>
                      <span class:list={[sidebarRow, account.email === previewAccount && sidebarRowCurrent]}>
                        <img
                          alt=""
                          class:list={["size-4 shrink-0 object-contain", account.provider === "apple" && "dark:invert"]}
                          height="16"
                          src={`/providers/${account.provider}.svg`}
                          width="16"
                        />
                        <span class="min-w-0 flex-1 truncate">{account.email}</span>
                        {account.unread > 0 ? <span class={sidebarCount}>{account.unread}</span> : null}
                        <ChevronRightIcon
                          className={cn("size-3.5 shrink-0 text-muted-foreground", account.expanded && "rotate-90")}
                        />
                      </span>
                      {account.expanded ? (
                        <ul class="flex flex-col gap-0.5 py-0.5">
                          {sidebarMailboxes.map(({ icon: Icon, name }) => (
                            <li>
                              <span class:list={[sidebarRow, "ps-7"]}>
                                <Icon className="size-4 shrink-0" />
                                <span class="min-w-0 flex-1 truncate">{name}</span>
                              </span>
                            </li>
                          ))}
                          <li>
                            <span class:list={[sidebarRow, "ps-7"]}>
                              <TagsIcon className="size-4 shrink-0" />
                              <span class="min-w-0 flex-1 truncate">Labels</span>
                              <ChevronRightIcon className="size-3.5 shrink-0 rotate-90 text-muted-foreground" />
                            </span>
                            <ul class="flex flex-col gap-0.5 pt-0.5">
                              {mailboxLabels.map((label) => (
                                <li>
                                  <span class:list={[sidebarRow, "ps-10.5"]}>
                                    <TagIcon className="size-4 shrink-0" style={{ color: label.background }} />
                                    <span class="min-w-0 flex-1 truncate">{label.name}</span>
                                    {label.unread > 0 ? <span class={sidebarCount}>{label.unread}</span> : null}
                                  </span>
                                </li>
                              ))}
                            </ul>
                          </li>
                        </ul>
                      ) : null}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="flex shrink-0 items-center gap-1 px-2 pb-2 pt-1">
                <span class:list={[previewIconButton, "size-8"]} title="Settings (⌘ ,)">
                  <SettingsIcon className="size-4 stroke-[1.8]" />
                </span>
                <span class:list={[previewIconButton, "size-8"]} title="Templates (⌘ ⇧ T)">
                  <FilesIcon className="size-4 stroke-[1.8]" />
                </span>
                <span class:list={[previewIconButton, "ms-auto size-8"]} title="Add account">
                  <PlusIcon className="size-4 stroke-[1.8]" />
                </span>
              </div>
            </div>

            <div class="flex min-w-0 flex-1 flex-col">
              {/* Below md the sidebar is hidden, as when it is collapsed in the app:
                  its toggle, history, and New email move into this titlebar. */}
              <div class="relative flex h-10.5 shrink-0 items-center gap-2 bg-background pe-2 ps-2 sm:ps-20 md:ps-0">
                <div class="absolute start-4.5 hidden gap-2 sm:flex md:hidden" aria-hidden="true">
                  <span class="size-3 rounded-full bg-foreground/15"></span>
                  <span class="size-3 rounded-full bg-foreground/15"></span>
                  <span class="size-3 rounded-full bg-foreground/15"></span>
                </div>
                <div class="flex shrink-0 items-center gap-1 md:hidden">
                  <span class:list={[previewIconButton, "size-7"]} title="Show sidebar">
                    <PanelLeftOpenIcon className="size-4 stroke-[1.8]" />
                  </span>
                  <span class:list={[previewIconButton, "size-7"]} title="Go back">
                    <ArrowLeftIcon className="size-4 stroke-[1.8]" />
                  </span>
                  <span class:list={[previewIconButton, "size-7 opacity-50"]} title="Go forward">
                    <ArrowRightIcon className="size-4 stroke-[1.8]" />
                  </span>
                  <span class="grid size-7 shrink-0 place-items-center rounded-md bg-primary text-primary-foreground" title="New email (⌘ N)">
                    <SquarePenIcon className="size-4 stroke-[1.8]" />
                  </span>
                </div>
                <ol class="flex min-w-0 flex-1 items-center gap-1.5 text-[13px] text-muted-foreground md:ps-4">
                  <li class="min-w-0 truncate">{previewAccount}</li>
                  <li class="shrink-0" aria-hidden="true">
                    <ChevronRightIcon className="size-3.5" />
                  </li>
                  <li class="shrink-0 font-medium text-foreground">Inbox</li>
                </ol>
              </div>

              <div class="app-preview-list min-h-0 flex-1 overflow-hidden">
                {threadDays.map(({ day, threads }) => (
                  <div>
                    <div class="-mt-px flex h-8 items-center border-y border-border/60 bg-[color-mix(in_oklab,var(--muted)_40%,var(--background))] px-4 text-xs font-medium text-muted-foreground">
                      {day}
                    </div>
                    <ol>
                      {threads.map((thread) => (
                        <li class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4 border-b border-border/60 px-4 py-3">
                          <div class="flex min-w-0 flex-col gap-1">
                            <div class="flex min-w-0 flex-wrap items-center gap-2">
                              <span class="flex max-w-full min-w-0 items-center gap-1.5 text-xs leading-snug font-medium">
                                <span class:list={["min-w-0 truncate", thread.unread ? "font-semibold text-foreground" : "font-normal text-foreground/80"]}>
                                  {thread.sender}
                                </span>
                                <span class="min-w-0 truncate text-muted-foreground">{thread.email}</span>
                              </span>
                              {thread.starred ? (
                                <span class="inline-flex shrink-0 text-muted-foreground" title="Starred">
                                  <StarIcon className="size-3.5 fill-current stroke-[1.8]" />
                                </span>
                              ) : null}
                              {thread.labels?.map((label) => {
                                const color = labelColors.get(label);

                                return (
                                  <span
                                    class="inline-flex h-4 max-w-28 shrink-0 items-center rounded-full bg-muted px-1.5 text-[10px] font-medium text-muted-foreground"
                                    style={color === undefined ? undefined : { backgroundColor: color.background, color: color.text }}
                                  >
                                    <span class="min-w-0 truncate">{label}</span>
                                  </span>
                                );
                              })}
                            </div>
                            <div class="flex min-w-0 items-center gap-1.5">
                              <p class:list={["min-w-0 truncate text-sm leading-snug", thread.unread ? "font-semibold text-foreground" : "text-foreground/80"]}>
                                {thread.subject}
                              </p>
                              {thread.messageCount === undefined ? null : (
                                <span class="inline-flex shrink-0 items-center gap-1 text-xs tabular-nums text-muted-foreground" title={`${thread.messageCount} messages`}>
                                  <MessagesSquareIcon className="size-3" />
                                  {thread.messageCount}
                                </span>
                              )}
                            </div>
                            <p class="truncate text-sm text-muted-foreground">{thread.preview}</p>
                            {thread.attachments === undefined ? null : (
                              <div class="flex flex-wrap items-center gap-1.5 pt-1">
                                {thread.attachments.slice(0, 3).map((attachment) => {
                                  const AttachmentIcon = attachment.kind === "preview" ? EyeIcon : DownloadIcon;

                                  return (
                                    <span class="flex h-6 max-w-56 items-center gap-1 rounded-md bg-muted pe-2 ps-1.5 text-xs font-medium text-muted-foreground">
                                      <AttachmentIcon className="size-2.5 shrink-0" />
                                      <span class="min-w-0 truncate">{attachment.filename}</span>
                                      <span class="shrink-0 border-s border-border/80 ps-2 text-[0.625rem] font-semibold tracking-wide text-foreground/50">
                                        {attachment.type}
                                      </span>
                                    </span>
                                  );
                                })}
                                {thread.attachments.length > 3 ? (
                                  <span class="flex h-5 items-center rounded-full bg-muted px-2 text-[0.625rem] font-medium text-muted-foreground">
                                    +{thread.attachments.length - 3}
                                  </span>
                                ) : null}
                              </div>
                            )}
                          </div>
                          <div class="flex items-center gap-1.5 pt-0.5">
                            {thread.unread ? <span class="size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span> : null}
                            <time class:list={["shrink-0 whitespace-nowrap text-xs tabular-nums", thread.unread ? "font-medium text-foreground" : "text-muted-foreground"]}>
                              {thread.time}
                            </time>
                          </div>
                        </li>
                      ))}
                    </ol>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="border-y bg-card/70" id="ai">
        <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 sm:px-8 sm:py-24 lg:grid-cols-[0.85fr_1.15fr]">
          <div class="min-w-0">
            <h2 class="max-w-lg text-balance text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">
              Write the reply. Keep your voice.
            </h2>
            <p class="mt-5 max-w-xl text-pretty text-base leading-7 text-muted-foreground">
              Create a reply from the conversation or clean up a draft in place. Kisa uses your existing Codex, Claude Code, or OpenCode setup without copying provider credentials into the app.
            </p>

            <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-3 text-sm text-muted-foreground">
              <li class="flex items-center gap-2">
                <CheckIcon className="size-3.5 text-foreground" />
                Reply from context
              </li>
              <li class="flex items-center gap-2">
                <CheckIcon className="size-3.5 text-foreground" />
                Clean up a draft
              </li>
              <li class="flex items-center gap-2">
                <CheckIcon className="size-3.5 text-foreground" />
                Choose your model
              </li>
            </ul>
          </div>

          <div class="relative mt-7 min-w-0 lg:mt-0">
            <ul aria-label="Supported AI providers" class="absolute -top-7 right-6 z-20 flex items-center gap-2">
              <li class="grid size-14 place-items-center rounded-xl bg-secondary shadow-lg" title="Codex">
                <img alt="" class="size-7 dark:invert" height="28" src="/codex-mark.svg" width="28" />
                <span class="sr-only">Codex</span>
              </li>
              <li class="grid size-14 place-items-center rounded-xl bg-secondary shadow-lg" title="Claude Code">
                <img alt="" class="size-7" height="28" src="/claude-mark.svg" width="28" />
                <span class="sr-only">Claude Code</span>
              </li>
              <li class="grid size-14 place-items-center rounded-xl bg-secondary shadow-lg" title="OpenCode">
                <img alt="" class="h-7 w-5 dark:invert" height="28" src="/opencode-mark.svg" width="20" />
                <span class="sr-only">OpenCode</span>
              </li>
            </ul>

            <div class="app-shadow overflow-hidden rounded-2xl border bg-background ring-1 ring-foreground/5" aria-label="Example Kisa AI reply composer">
              <div class="flex flex-col gap-px bg-background">
              <div class="flex min-w-0 items-center gap-1.5 bg-card px-4 py-2 text-xs text-muted-foreground max-sm:pe-54">
                <span class="truncate">Replying to Maya Chen</span>
                <span aria-hidden="true">·</span>
                <span class="shrink-0 tabular-nums">10:42</span>
