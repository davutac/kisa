---
import {
  ArchiveRestoreIcon,
  ArrowRightIcon,
  BoldIcon,
  CheckIcon,
  CodeIcon,
  DatabaseIcon,
  DownloadIcon,
  EyeIcon,
  FileCodeIcon,
  FilesIcon,
  HouseIcon,
  ItalicIcon,
  KeyboardIcon,
  LinkIcon,
  ListIcon,
  ListOrderedIcon,
  MailIcon,
  MessageSquarePlusIcon,
  MinusIcon,
  PlusIcon,
  QuoteIcon,
  Redo2Icon,
  SearchIcon,
  SendIcon,
  SettingsIcon,
  ShieldAlertIcon,
  ShieldCheckIcon,
  SparklesIcon,
  SquarePenIcon,
  StrikethroughIcon,
  Trash2Icon,
  UnderlineIcon,
  Undo2Icon,
  UserRoundIcon,
  XIcon,
} from "lucide-react";

import GithubMark from "@/components/github-mark.astro";
import ThemeToggle from "@/components/theme-toggle";
import { buttonVariants } from "@/components/ui/button";
import XMark from "@/components/x-mark.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { cn } from "@/lib/utils";

const repositoryUrl = "https://github.com/davutac/kisa";

const features = [
  {
    description:
      "Create replies from thread context or clean up a draft with Codex, Claude Code, or OpenCode.",
    icon: SparklesIcon,
    title: "AI writing, your choice",
  },
  {
    description:
      "Save the sender, recipients, subject, and body together. Type / in a new email to insert it with variables resolved.",
    icon: FilesIcon,
    title: "Reusable templates",
  },
  {
    description:
      "Clear new mail without losing track. Stash a message and Kisa brings it back when you choose.",
    icon: ArchiveRestoreIcon,
    title: "Stash until later",
  },
  {
    description:
      "Your cache and full-text search index live in an encrypted database on your device.",
    icon: DatabaseIcon,
    title: "Local by design",
  },
  {
    description:
      "Move through mail, search, switch accounts, and take action without reaching for the mouse.",
    icon: KeyboardIcon,
    title: "Made for momentum",
  },
  {
    description:
      "Credentials stay outside the renderer. Message HTML is isolated and remote images wait for you.",
    icon: ShieldCheckIcon,
    title: "Private by default",
  },
];

const inlineComposerTools = [
  { icon: BoldIcon, label: "Bold" },
  { icon: ItalicIcon, label: "Italic" },
  { icon: UnderlineIcon, label: "Underline" },
  { icon: StrikethroughIcon, label: "Strikethrough" },
  { icon: CodeIcon, label: "Inline code" },
  { icon: LinkIcon, label: "Link" },
];

const blockComposerTools = [
  { icon: ListIcon, label: "Bulleted list" },
  { icon: ListOrderedIcon, label: "Numbered list" },
  { icon: QuoteIcon, label: "Quote" },
  { icon: FileCodeIcon, label: "Code block" },
  { icon: MinusIcon, label: "Horizontal rule" },
];

const historyComposerTools = [
  { icon: Undo2Icon, label: "Undo" },
  { icon: Redo2Icon, label: "Redo" },
];

const mailboxLabels = [
  {
    background: "#3c78d8",
    name: "Design",
    selected: true,
    text: "#ffffff",
  },
  { background: "#8e63ce", name: "Personal", text: "#ffffff" },
  { background: "#a479e2", name: "Photos", text: "#ffffff" },
  { background: "#eaa041", name: "Updates", text: "#3c1f00" },
  { background: "#0b8043", name: "Work", text: "#ffffff" },
];

const threads = [
  {
    attachments: [
      { filename: "design-notes.pdf", kind: "preview", type: "PDF" },
      { filename: "handoff.zip", kind: "download", type: "ZIP" },
    ],
    email: "maya@example.com",
    labels: ["Work", "Design"],
    preview: "The calm direction feels right. One thought…",
    sender: "Maya Chen",
    subject: "Design review",
    time: "10:42",
    unread: true,
  },
  {
    email: "alex@example.com",
    labels: ["Personal"],
    preview: "Saturday morning works perfectly for us.",
    sender: "Alex Morgan",
    subject: "Weekend plans",
    time: "09:18",
    unread: true,
  },
  {
    email: "notifications@linear.app",
    labels: ["Updates"],
    preview: "12 issues completed across 3 projects.",
    sender: "Linear",
    subject: "Your weekly digest",
    time: "Mon",
    unread: false,
  },
  {
    attachments: [
      { filename: "berlin-01.jpg", kind: "preview", type: "JPG" },
      { filename: "berlin-02.jpg", kind: "preview", type: "JPG" },
      { filename: "berlin-03.jpg", kind: "preview", type: "JPG" },
      { filename: "weekend-map.pdf", kind: "preview", type: "PDF" },
    ],
    email: "nora@example.com",
    labels: ["Photos"],
    preview: "Finally sorted these. Thought you'd like them.",
    sender: "Nora Patel",
    subject: "Photos from Berlin",
    time: "Sun",
    unread: false,
  },
  {
    email: "hello@raycast.com",
    preview: "A calmer command bar and a few small refinements.",
    sender: "Raycast",
    subject: "What's new this week",
    time: "Fri",
    unread: false,
  },
];
---

<BaseLayout
  description="Kisa is a local-first desktop email client with AI writing through your existing Codex, Claude Code, or OpenCode setup."
  title="Kisa"
>
  <div class="page-shell relative overflow-x-clip">
    <header class="sticky inset-x-0 top-0 z-50" data-sticky-header>
      <div aria-hidden="true" class="header-backdrop" data-header-backdrop></div>
      <div class="relative mx-auto flex h-18 max-w-6xl items-center justify-between px-5 sm:px-8">
        <a class="flex items-center gap-2.5" href="#top" aria-label="Kisa home">
          <img
            alt=""
            class="size-8 rounded-lg shadow-sm"
            height="32"
            src="/icon.png"
            width="32"
          />
          <span class="text-sm font-semibold tracking-tight">Kisa</span>
        </a>

        <nav class="flex items-center gap-1" aria-label="Primary navigation">
          <a class="hidden rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground sm:block" href="#features">
            Features
          </a>
          <a class="hidden rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground sm:block" href="#ai">
            AI writing
          </a>
          <a class="hidden rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground sm:block" href="/privacy/">
            Privacy
          </a>
          <a
            class="inline-flex size-10 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            href={repositoryUrl}
            rel="noreferrer"
            target="_blank"
            aria-label="View Kisa on GitHub"
          >
            <GithubMark />
          </a>
          <ThemeToggle client:load />
        </nav>
      </div>
    </header>

    <main class="relative z-10" id="top">
      <section class="mx-auto flex max-w-4xl flex-col items-center px-5 pb-16 pt-22 text-center sm:px-8 sm:pb-24 sm:pt-30">
        <h1 class="reveal max-w-3xl text-balance text-5xl font-semibold tracking-[-0.055em] sm:text-7xl sm:leading-[0.98]">
          Email, without the noise.
        </h1>

        <p class="reveal reveal-delay mt-6 max-w-2xl text-pretty text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
          Read, search, write, and organize mail in one calm desktop app. When you want help writing, Kisa works with the AI tools already installed and signed in on your computer.
        </p>

        <div class="reveal reveal-delay mt-8 flex flex-col items-center gap-3 sm:flex-row">
          <a
            class={cn(buttonVariants({ size: "lg" }), "group min-w-42")}
            href={repositoryUrl}
            rel="noreferrer"
            target="_blank"
          >
            <GithubMark tone="inverse" />
            Follow on GitHub
            <ArrowRightIcon className="transition-transform group-hover:translate-x-0.5" />
          </a>
          <a class={cn(buttonVariants({ size: "lg", variant: "outline" }), "min-w-42")} href="#features">
            See why Kisa
          </a>
        </div>

        <p class="reveal reveal-delay mt-5 flex items-center gap-2 text-xs text-muted-foreground">
          <CheckIcon className="size-3.5" />
          Works with Google accounts · Open source
        </p>
      </section>

      <section class="mx-auto max-w-6xl px-3 pb-24 sm:px-8 sm:pb-32" aria-label="Kisa desktop app preview">
        <div class="app-shadow overflow-hidden rounded-2xl border bg-background ring-1 ring-foreground/5">
          <div class="relative flex h-11 items-center justify-between gap-2 bg-background px-3 sm:ps-21">
            <div class="absolute start-4 flex gap-1.5 max-sm:hidden" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-foreground/15"></span>
              <span class="size-2.5 rounded-full bg-foreground/15"></span>
              <span class="size-2.5 rounded-full bg-foreground/15"></span>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
              <span class="grid size-7 place-items-center rounded-md bg-primary text-primary-foreground shadow-xs">
                <SquarePenIcon className="size-3.5" />
              </span>
              <span class="flex items-center gap-1">
                <span class="grid size-7 place-items-center rounded-md text-muted-foreground">
                  <HouseIcon className="size-3.5" />
                </span>
                <span class="flex h-7 items-center rounded-md bg-secondary text-[10px] font-medium sm:pe-2.5">
                  <span class="grid size-7 place-items-center rounded-md bg-muted">
                    <UserRoundIcon className="size-3.5" />
                  </span>
                  <span class="hidden ps-1.5 sm:block">davut@example.com</span>
                </span>
                <span class="grid size-7 place-items-center rounded-md text-muted-foreground">
                  <PlusIcon className="size-3.5" />
                </span>
              </span>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
              <span class="flex items-center gap-1">
                <span class="grid size-7 place-items-center rounded-md bg-secondary" title="Search mail (⌘ K)">
                  <SearchIcon className="size-3.5" />
                </span>
                <span class="grid size-7 place-items-center rounded-md text-muted-foreground" title="Unread (U)">
                  <MailIcon className="size-3.5" />
                </span>
                <span class="grid size-7 place-items-center rounded-md text-muted-foreground" title="Spam (S)">
                  <ShieldAlertIcon className="size-3.5" />
                </span>
              </span>
              <span class="flex items-center gap-1">
                <span class="grid size-7 place-items-center rounded-md text-muted-foreground" title="Templates (⌘ ⇧ T)">
                  <FilesIcon className="size-3.5" />
                </span>
                <span class="grid size-7 place-items-center rounded-md text-muted-foreground" title="Settings (⌘ ,)">
                  <SettingsIcon className="size-3.5" />
                </span>
              </span>
            </div>
          </div>

          <div class="flex h-10 items-center overflow-hidden px-3 sm:px-4" aria-label="Example mailbox label filters">
            <span class="grid size-6 shrink-0 place-items-center rounded-md bg-secondary text-muted-foreground" title="Clear label filters (⌘ ⇧ L)">
              <XIcon className="size-3" />
            </span>
            <div class="flex min-w-0 flex-1 snap-x snap-proximity items-center gap-1 overflow-x-auto overscroll-x-contain pe-8 ps-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {mailboxLabels.map((label) => (
                <span
                  class="flex h-6 shrink-0 snap-center items-center rounded-md px-2 text-xs font-medium whitespace-nowrap"
                  style={`background-color: ${label.selected ? label.background : `color-mix(in oklch, ${label.background} 5%, transparent)`}; color: ${label.selected ? label.text : "var(--foreground)"};`}
                >
                  {label.name}
                </span>
              ))}
            </div>
          </div>

          <section class="min-h-120 bg-background px-3 pb-3 sm:px-4 sm:pb-4" aria-label="Example Kisa inbox">
            <ol class="relative space-y-px">
              {threads.map((thread) => (
                <li
                  class:list={[
                    "relative grid min-h-20 grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4 rounded-md px-4 py-3",
                    thread.unread ? "bg-muted/30" : "opacity-60",
                  ]}
                >
                  <div class="min-w-0 space-y-1">
                    <div class="flex min-w-0 items-center gap-1.5 text-xs">
                      <span class="truncate font-medium">{thread.sender}</span>
                      <span class="truncate text-muted-foreground">{thread.email}</span>
                      {thread.labels?.map((label) => (
                        <span class="h-4 max-w-28 shrink-0 truncate rounded-full bg-muted px-1.5 text-[10px] leading-4 text-muted-foreground">
                          {label}
                        </span>
                      ))}
                    </div>
                    <p class:list={["truncate text-sm", thread.unread ? "font-semibold" : "font-medium text-foreground/90"]}>
                      {thread.subject}
                    </p>
                    <p class="truncate text-sm text-muted-foreground">{thread.preview}</p>
                    {thread.attachments === undefined ? null : (
                      <div class="flex flex-wrap items-center gap-1.5 pt-1">
                        {thread.attachments.slice(0, 3).map((attachment) => {
                          const AttachmentIcon = attachment.kind === "preview" ? EyeIcon : DownloadIcon;

                          return (
                            <span class="flex h-6 max-w-56 items-center gap-1.5 rounded-md bg-muted px-2 text-[10px] font-medium text-muted-foreground">
                              <AttachmentIcon className="size-2.5 shrink-0" />
                              <span class="min-w-0 truncate">{attachment.filename}</span>
                              <span class="shrink-0 border-s border-border/80 ps-2 text-[9px] font-semibold tracking-wide text-foreground/50">
                                {attachment.type}
                              </span>
                            </span>
                          );
                        })}
                        {thread.attachments.length > 3 ? (
                          <span class="flex h-5 items-center rounded-full bg-muted px-2 text-[10px] font-medium text-muted-foreground">
                            +{thread.attachments.length - 3}
                          </span>
                        ) : null}
                      </div>
                    )}
                  </div>
                  <time class:list={["pt-0.5 text-xs", thread.unread ? "font-medium text-foreground" : "text-muted-foreground"]}>
                    {thread.time}
                  </time>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </section>

      <section class="border-y bg-card/70" id="ai">
        <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-20 sm:px-8 sm:py-24 lg:grid-cols-[0.85fr_1.15fr]">
          <div>
            <h2 class="max-w-lg text-balance text-3xl font-semibold tracking-[-0.035em] sm:text-4xl">
              Write the reply. Keep your voice.
            </h2>
            <p class="mt-5 max-w-xl text-pretty text-base leading-7 text-muted-foreground">
              Create a reply from the conversation or clean up a draft in place. Kisa uses your existing Codex, Claude Code, or OpenCode setup without copying provider credentials into the app.
            </p>

            <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-3 text-sm text-muted-foreground">
              <li class="flex items-center gap-2">
                <CheckIcon className="size-3.5 text-foreground" />
                Reply from context
              </li>
              <li class="flex items-center gap-2">
                <CheckIcon className="size-3.5 text-foreground" />
                Clean up a draft
              </li>
              <li class="flex items-center gap-2">
                <CheckIcon className="size-3.5 text-foreground" />
                Choose your model
              </li>
            </ul>
          </div>

          <div class="relative mt-7 lg:mt-0">
            <ul aria-label="Supported AI providers" class="absolute -top-7 right-6 z-20 flex items-center gap-2">
              <li class="grid size-14 place-items-center rounded-xl bg-secondary shadow-lg" title="Codex">
                <img alt="" class="size-7 dark:invert" height="28" src="/codex-mark.svg" width="28" />
                <span class="sr-only">Codex</span>
              </li>
              <li class="grid size-14 place-items-center rounded-xl bg-secondary shadow-lg" title="Claude Code">
                <img alt="" class="size-7" height="28" src="/claude-mark.svg" width="28" />
                <span class="sr-only">Claude Code</span>
              </li>
              <li class="grid size-14 place-items-center rounded-xl bg-secondary shadow-lg" title="OpenCode">
                <img alt="" class="h-7 w-5 dark:invert" height="28" src="/opencode-mark.svg" width="20" />
                <span class="sr-only">OpenCode</span>
              </li>
            </ul>

            <div class="app-shadow overflow-hidden rounded-2xl border bg-background ring-1 ring-foreground/5" aria-label="Example Kisa AI reply composer">
              <div class="flex flex-col gap-px bg-background">
              <div class="flex min-w-0 items-center gap-1.5 bg-card px-4 py-2 text-xs text-muted-foreground">
                <span class="truncate">Replying to Maya Chen</span>
                <span aria-hidden="true">·</span>
                <span class="shrink-0">just now</span>
              </div>

              <div class="flex min-h-9 items-center bg-card px-4">
                <span class="w-10 shrink-0 text-xs font-medium text-muted-foreground">To</span>
                <span class="inline-flex h-6 min-w-0 items-center gap-1 rounded-full bg-secondary px-2.5 pe-1.5 text-xs font-medium">
                  <span class="truncate">maya@example.com</span>
                  <span class="grid size-3.5 shrink-0 place-items-center rounded-full">
                    <XIcon className="size-2.5" />
                  </span>
                </span>
                <span class="min-w-6 flex-1"></span>
                <span class="rounded-sm px-1 text-[0.625rem] font-medium text-muted-foreground">Cc</span>
                <span class="ms-1 rounded-sm px-1 text-[0.625rem] font-medium text-muted-foreground">Bcc</span>
              </div>

              <div class="flex min-h-48 flex-col gap-px bg-background">
                <div class="min-h-36 flex-1 bg-card px-4 py-2 text-sm leading-relaxed sm:min-h-44">
                  <p>Thanks, Maya. The calmer direction feels right.</p>
                  <p class="mt-3">Let’s keep the hierarchy as it is and soften the secondary actions before handoff. I’ll send an updated pass tomorrow morning.</p>
                </div>

                <div class="flex items-center gap-2 bg-card px-2 py-1" aria-label="Formatting toolbar">
                  <div class="flex min-w-0 flex-1 items-center gap-0.5 overflow-hidden">
                    {inlineComposerTools.map(({ icon: Icon, label }) => (
                      <span class="grid size-7 shrink-0 place-items-center rounded-md text-muted-foreground" title={label}>
                        <Icon className="size-3.5" />
                      </span>
                    ))}
                    <span aria-hidden="true" class="mx-1 h-4 w-px shrink-0 bg-border"></span>
                    {blockComposerTools.map(({ icon: Icon, label }) => (
                      <span class="grid size-7 shrink-0 place-items-center rounded-md text-muted-foreground" title={label}>
                        <Icon className="size-3.5" />
                      </span>
                    ))}
                    <span aria-hidden="true" class="mx-1 h-4 w-px shrink-0 bg-border"></span>
                    {historyComposerTools.map(({ icon: Icon, label }) => (
                      <span class="grid size-7 shrink-0 place-items-center rounded-md text-muted-foreground" title={label}>
                        <Icon className="size-3.5" />
                      </span>
                    ))}
                  </div>

                  <div class="ms-auto flex shrink-0 items-center gap-1">
                    <div class="ai-action-surface relative isolate overflow-hidden rounded-md">
                      <span aria-hidden="true" class="ai-action-gradient pointer-events-none absolute left-1/2 top-1/2 aspect-square w-[200%]"></span>
                      <div class="relative z-10 flex gap-px overflow-hidden rounded-[calc(var(--radius-md)-1px)] bg-background">
                        <span class="flex h-7 items-center gap-1 bg-card px-2 text-xs font-medium text-muted-foreground opacity-50">
                          <MessageSquarePlusIcon className="size-3.5" />
                          Create reply
                        </span>
                        <span class="flex h-7 items-center gap-1 bg-card px-2 text-xs font-medium">
                          <SparklesIcon className="size-3.5" />
                          Clean
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

                <div class="flex h-12 items-stretch gap-px bg-background">
                  <span class="flex min-w-0 flex-1 items-center justify-center gap-1 bg-secondary px-4 text-base font-medium">
                    <SendIcon className="size-4" />
                    Send
                    <span class="ms-2 inline-flex items-center gap-0.5" aria-hidden="true">
                      <kbd class="inline-flex h-5 min-w-5 items-center justify-center rounded-lg bg-muted px-1 text-[0.625rem] font-medium text-muted-foreground">⌘</kbd>
                      <kbd class="inline-flex h-5 min-w-5 items-center justify-center rounded-lg bg-muted px-1 text-[0.625rem] font-medium text-muted-foreground">↵</kbd>
                    </span>
                  </span>
                  <span class="grid size-12 place-items-center bg-secondary">
                    <Trash2Icon className="size-4" />
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="features">
        <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8 sm:py-32">
          <div class="max-w-xl">
            <h2 class="text-balance text-3xl font-semibold tracking-[-0.035em] sm:text-5xl">Everything you need. Less of everything else.</h2>
          </div>

          <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
            {features.map(({ icon: Icon, title, description }) => (
              <article class="bg-background p-7 sm:p-8">
                <div class="grid size-9 place-items-center rounded-lg border bg-card shadow-xs">
                  <Icon className="size-4" />
                </div>
                <h3 class="mt-8 text-sm font-semibold">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 sm:px-8 sm:py-32 lg:grid-cols-2" id="privacy">
        <div>
          <h2 class="max-w-lg text-balance text-3xl font-semibold tracking-[-0.035em] sm:text-5xl">Local by default. Explicit when AI needs context.</h2>
          <p class="mt-5 max-w-xl text-pretty text-base leading-7 text-muted-foreground">
            Kisa has no remote mailbox backend. Mail data and search indexes stay on your device. AI writing sends only the draft or bounded cached thread context when you invoke it, directly to the provider you selected and under its data terms.
          </p>
        </div>

        <div class="rounded-2xl border bg-card p-3 shadow-sm">
          <div class="rounded-xl border bg-background p-5 sm:p-7">
            <div class="flex items-center gap-3 border-b pb-5">
              <span class="grid size-9 place-items-center rounded-lg bg-foreground text-background">
                <ShieldCheckIcon className="size-4" />
              </span>
              <div>
                <p class="text-sm font-semibold">Narrow by design</p>
                <p class="text-xs text-muted-foreground">Only the capability each surface needs</p>
              </div>
            </div>
            <ul class="mt-5 space-y-4 text-sm">
              <li class="flex gap-3"><CheckIcon className="mt-0.5 size-4 shrink-0" /><span>Encrypted local database and credentials</span></li>
              <li class="flex gap-3"><CheckIcon className="mt-0.5 size-4 shrink-0" /><span>Sandboxed message content with remote images blocked</span></li>
              <li class="flex gap-3"><CheckIcon className="mt-0.5 size-4 shrink-0" /><span>AI receives content only for actions you start</span></li>
              <li class="flex gap-3"><CheckIcon className="mt-0.5 size-4 shrink-0" /><span>Typed, account-scoped boundaries across the app</span></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8 sm:pb-32">
        <div class="relative overflow-hidden rounded-3xl border bg-primary px-6 py-16 text-center text-primary-foreground sm:px-12 sm:py-22">
          <div class="relative z-10 mx-auto max-w-2xl">
