      "drizzle-orm": "1.0.0-rc.6",
      "electron": "^45.5.0",
      "electron-builder": "26.18.0",
      "electron-updater": "^6.8.11",
      "electron-vite": "6.0.0",
      "effect": "4.1.5",
      "husky": "^9.1.7",
      "imapflow": "2.12.2",
      "lucide-react": "^1.79.0",
      "motion": "^14.14.0",
      "nodemailer": "10.6.1",
      "oxfmt": "^0.80.0",
      "oxlint": "1.94.0",
      "oxlint-tsgolint": "7.0.2008",
      "pdfjs-dist": "^6.5.438",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sharp": "^0.35.5",
      "tailwind-merge": "^3.7.1",
      "tailwindcss": "^4.3.5",
      "tldts": "7.5.5",
      "turbo": "^2.11.13",
      "typescript": "7.0.2",
      "ultracite": "8.3.1",
      "vite": "^8.3.8",
      "vitest": "^5.1.1",
      "wrangler": "^4.168.0",
      "zod": "^4.6.7",
      "zustand": "^5.1.0"
    },
    "catalogs": {
      "astro": {
        "typescript": "6.0.3"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=kisa",
    "build:linux": "turbo run build:linux",
    "build:mac": "turbo run build:mac",
    "build:marketing": "turbo run build --filter=@kisa/marketing",
    "build:unpack": "turbo run build:unpack",
    "build:win": "turbo run build:win",
    "check": "ultracite check --disable-nested-config",
    "deploy:marketing": "turbo run deploy --filter=@kisa/marketing",
    "dev": "turbo run dev --filter=kisa",
    "dev:marketing": "turbo run dev --filter=@kisa/marketing",
    "fix": "ultracite fix --disable-nested-config",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint --skip-missing",
    "release": "node scripts/release.mjs",
    "start": "turbo run start",
    "test": "bun run --workspaces --if-present test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "overrides": {
    "@opencode/client@2.4.1": {
      "effect": "catalog:"
    },
    "@opencode/protocol@2.4.1": {
      "effect": "catalog:"
    },
    "@opencode/schema@2.4.1": {
      "effect": "catalog:"
    }
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "better-sqlite3-multiple-ciphers",
    "electron-winstaller",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
