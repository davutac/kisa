{
  "name": "kisa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:linux": "turbo run build:linux",
    "build:mac": "turbo run build:mac",
    "build:unpack": "turbo run build:unpack",
    "build:win": "turbo run build:win",
    "check": "ultracite check --disable-nested-config",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "fix": "ultracite fix --disable-nested-config",
    "lint": "ultracite check --disable-nested-config",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint",
    "release": "node scripts/release.mjs",
    "start": "turbo run start",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "packageManager": "pnpm@11.20.0"
}
