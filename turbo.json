{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**"],
      "passThroughEnv": [
        "MAIN_VITE_GOOGLE_OAUTH_CLIENT_ID",
        "MAIN_VITE_GOOGLE_OAUTH_CLIENT_SECRET"
      ]
    },
    "build:linux": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "build:mac": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "build:unpack": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "build:win": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {}
  }
}
